  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>demo</artifactId>
  <packaging>pom</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>demo</name>

  <modules>
    <module>common</module>
    <module>designpattern</module>
    <module>huaweicloud</module>
    <module>lock</module>
    <module>oss/bsc</module>
    <module>oss/minio</module>
    <module>oss/aliyun</module>
    <module>rpc/dubbo</module>
    <module>rpc/springcloud</module>
    <module>sentinel</module>
    <module>xxljob</module>
    <module>document</module>
    <module>mqtt</module>
    <module>aliyun-mqtt</module>
